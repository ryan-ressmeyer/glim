{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimse.local/schemas/config-v1.json",
  "title": "Glimse daemon configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "store_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/",
      "description": "Absolute persistent store path. GLIM_STORE_ROOT takes precedence."
    },
    "bind": {
      "type": "string",
      "minLength": 1,
      "description": "Numeric IP socket address with a nonzero port. GLIM_BIND takes precedence."
    },
    "access": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "local"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "token_file", "public_origin"],
          "dependentRequired": {
            "tls_certificate": ["tls_private_key"],
            "tls_private_key": ["tls_certificate"]
          },
          "properties": {
            "mode": {"const": "token"},
            "token_file": {"type": "string", "minLength": 1, "pattern": "^/"},
            "public_origin": {"type": "string", "pattern": "^https?://[^/?#]+$"},
            "tls_certificate": {"type": "string", "minLength": 1, "pattern": "^/"},
            "tls_private_key": {"type": "string", "minLength": 1, "pattern": "^/"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "trusted_proxy_ips", "public_origin"],
          "properties": {
            "mode": {"const": "trusted_proxy"},
            "trusted_proxy_ips": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "anyOf": [
                  {"format": "ipv4"},
                  {"format": "ipv6"}
                ]
              }
            },
            "public_origin": {"type": "string", "pattern": "^https?://[^/?#]+$"}
          }
        }
      ]
    }
  }
}
