{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimse.local/schemas/cli-publish-v1.json",
  "title": "Glimse CLI publication input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integration_namespace", "external_session_key", "project_label", "working_directory", "title", "commentary", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "integration_namespace": {"type": "string", "minLength": 1},
    "external_session_key": {"type": "string", "minLength": 1},
    "project_label": {"type": "string", "minLength": 1},
    "working_directory": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "commentary": {"type": "string", "minLength": 1},
    "predecessor_post_id": {"type": ["integer", "null"], "minimum": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_path"],
        "properties": {
          "source_path": {"type": "string", "minLength": 1},
          "published_filename": {"type": ["string", "null"], "minLength": 1},
          "caption": {"type": ["string", "null"]},
          "media_type": {"type": ["string", "null"], "minLength": 1},
          "collect_assets": {"type": "boolean", "default": true}
        }
      }
    }
  }
}
